# Copy to .env for local use. Do not commit .env.
JARVIS_BACKEND_PORT=3001
JARVIS_DB_PATH=.data/jarvis.db

# Isi hanya di .env lokal. Jangan kirim kunci lewat chat atau commit.
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-5.6-terra
OPENAI_MODEL_DEEP=gpt-5.6-sol

# Opsional: tarif USD per 1 juta token untuk perkiraan biaya.
# OPENAI_FAST_INPUT_USD_PER_MILLION=
# OPENAI_FAST_OUTPUT_USD_PER_MILLION=
# OPENAI_DEEP_INPUT_USD_PER_MILLION=
# OPENAI_DEEP_OUTPUT_USD_PER_MILLION=
