{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "0.1.0",
  "identifier": "dev.jarvis.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w @jarvis/desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build -w @jarvis/desktop",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      { "title": "Jarvis", "width": 1100, "height": 720 }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
